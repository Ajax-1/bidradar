---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  intro?: string;
  updated?: string;
  jsonLd?: object[];
  noindex?: boolean;
}
const { heading, intro, updated, ...rest } = Astro.props;
---

<Base {...rest}>
  <div class="wrap page">
    <header class="page-head">
      <h1>{heading}</h1>
      {intro && <p class="lede">{intro}</p>}
      {updated && <p class="updated mono">Last updated {updated}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>

<style>
  .page {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(4rem, 8vw, 6rem);
  }
  .page-head {
    max-width: 46rem;
    display: grid;
    gap: 1rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  h1 {
    font-size: clamp(2.2rem, 1.5rem + 2.5vw, 3.25rem);
    letter-spacing: -0.04em;
  }
  .updated {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .prose {
    max-width: 46rem;
    padding-top: 2.5rem;
    color: var(--ink-2);
  }
  .prose :global(h2) {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 2.5rem 0 0.75rem;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p + p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 0.85rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
    display: grid;
    gap: 0.45rem;
  }
  .prose :global(a) {
    color: var(--accent-text);
    text-underline-offset: 3px;
  }
  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
</style>
