---
// PLACEHOLDER logo: a simple geometric mark plus wordmark.
// Replace this file's markup when the real logo is ready.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<span class={`logo ${cls}`}>
  <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".35"></circle>
    <circle cx="12" cy="12" r="6" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".6"></circle>
    <path d="M12 12 L12 1.5 A10.5 10.5 0 0 1 21.6 7.7 Z" fill="var(--accent)"></path>
    <circle cx="12" cy="12" r="1.75" fill="currentColor"></circle>
  </svg>
  <span class="logo-word">BidRadar</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    font-size: 1.125rem;
    color: var(--ink);
  }
</style>
