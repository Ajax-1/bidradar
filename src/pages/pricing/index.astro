---
import Base from '../../layouts/Base.astro';
import Pricing from '../../components/Pricing.astro';
import { SITE, absolute, contactHref, href } from '../../lib/site';

const { standard, founding, foundingSeats, trialDays } = SITE.pricing;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'BidRadar daily digest subscription',
    description:
      'Weekday email digest of new federal construction and facilities opportunities, filtered by trade and state, with summaries, 1-5 fit scores and bid advice.',
    brand: { '@type': 'Brand', name: SITE.name },
    offers: [
      { '@type': 'Offer', name: `Founding rate (first ${foundingSeats} customers)`, price: String(founding), priceCurrency: 'USD', url: absolute('/pricing/') },
      { '@type': 'Offer', name: 'Standard', price: String(standard), priceCurrency: 'USD', url: absolute('/pricing/') },
    ],
  },
];
---

<Base
  title="Pricing"
  description={`BidRadar costs $${standard}/month. The first ${foundingSeats} customers pay $${founding}/month, locked in. ${trialDays} free days, no credit card. Cancel any time. Full refund in your first month.`}
  path="/pricing/"
  jsonLd={jsonLd}
>
  <div class="wrap page">
    <header class="head">
      <h1>One plan. Priced for small contractors.</h1>
      <p class="lede">
        ${standard} a month, or ${founding} a month if you are one of our first {foundingSeats} customers.
        No contracts, no setup fees.
      </p>
    </header>

    <Pricing />

    <section class="details">
      <div>
        <h2>Billing</h2>
        <p>
          Payments are processed by our payment provider, Creem. You are billed monthly in U.S.
          dollars from the day you subscribe. We never see or store your card number.
        </p>
      </div>
      <div>
        <h2>Cancelling</h2>
        <p>
          Cancel any time by emailing us or replying to any digest. Your subscription stays active
          until the end of the month you have paid for, and you are not billed again.
        </p>
      </div>
      <div>
        <h2>Refunds</h2>
        <p>
          If BidRadar is not useful to you in your first paid month, email us within that month and
          we refund it in full. Details are in our <a class="text-link" href={href('/refund/')}>Refund Policy</a>.
        </p>
      </div>
      <div>
        <h2>Questions</h2>
        <p>
          Email <a class="text-link" href={contactHref}>{SITE.email}</a> and you will get a reply
          from the person who runs BidRadar.
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .page {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(4rem, 8vw, 6rem);
  }
  .head {
    max-width: 44rem;
    display: grid;
    gap: 1rem;
    margin-bottom: 3rem;
  }
  h1 {
    font-size: clamp(2.2rem, 1.5rem + 2.5vw, 3.25rem);
    letter-spacing: -0.04em;
  }
  .details {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 4rem;
  }
  .details h2 {
    font-size: 1.125rem;
    letter-spacing: -0.015em;
  }
  .details p {
    margin-top: 0.6rem;
    color: var(--ink-2);
    max-width: 52ch;
  }
  @media (max-width: 720px) {
    .details {
      grid-template-columns: 1fr;
    }
  }
</style>
